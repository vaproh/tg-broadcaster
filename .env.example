# From https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# From @BotFather
BOT_TOKEN=

# Your own numeric Telegram id (e.g. from @userinfobot). The owner.
OWNER_ID=

# Extra numeric Telegram ids allowed to use the bot, comma-separated.
# Each one gets their own accounts, campaigns, posts and sessions.
ALLOWED_USERS=
